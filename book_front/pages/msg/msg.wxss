/* 页面背景 */
page {
  background-color: #f2f2f2;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial;
}

/* 消息项整体样式 */
.list_item {
  background-color: #fff;
  margin: 12rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: row;
  padding: 16rpx 20rpx;
  align-items: center;
  transition: background-color 0.2s ease;
}

.list_item:active {
  background-color: #f5f5f5;
}

/* 头像样式 */
.head {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

/* 消息详情部分 */
.list_item .detail {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 左侧昵称和内容 */
.detail view view:first-child {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 10rpx;
}
.detail view view:last-child {
  font-size: 26rpx;
  color: #888;
  max-width: 300rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 商品图片样式 */
.goodImg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-left: 20rpx;
  object-fit: cover;
}

/* AI 客服样式优化 */
.ai-assistant {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  background: linear-gradient(90deg, #fefefe, #f8f8ff);
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.ai-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 2rpx solid #ddd;
}

.msg-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.msg-title {
  font-size: 34rpx;
  color: #333;
  font-weight: bold;
}

.msg-desc {
  font-size: 28rpx;
  color: #999;
  margin-top: 6rpx;
}

.msg-time {
  font-size: 24rpx;
  color: #bbb;
  margin-left: 20rpx;
}
