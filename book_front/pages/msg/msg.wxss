/* pages/msg/msg.wxss */
page {
  background-color: #eeeeee;
}
.list_item {
  background-color: white;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-bottom: solid 2rpx #eeeeee;
}
.head {
  width: 15%;
  padding: 16rpx;
}
.list_item .detail {
  width: 85%;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.goodImg {
  width: 125rpx;
  height: 125rpx;
}

/* AI客服样式 */
.ai-assistant {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
  background-color: #f8f8ff;
}

.ai-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.msg-content {
  flex: 1;
}

.msg-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.msg-desc {
  font-size: 28rpx;
  color: #999;
}

.msg-time {
  font-size: 24rpx;
  color: #bbb;
}
