<view class="container">
  <view class="tabs">
    <view class="tab {{activeTab === 'content' ? 'active' : ''}}" bindtap="switchTab" data-tab="content">推荐</view>
    <view class="tab {{activeTab === 'popular' ? 'active' : ''}}" bindtap="switchTab" data-tab="popular">热门</view>
    <view class="tab {{activeTab === 'new' ? 'active' : ''}}" bindtap="switchTab" data-tab="new">新品</view>
  </view>
  
  <view class="goods-list">
    <block wx:if="{{loading}}">
      <view class="loading">加载中...</view>
    </block>
    <block wx:elif="{{goods.length === 0}}">
      <view class="empty">暂无推荐商品</view>
    </block>
    <block wx:else>
      <view class="goods-item" wx:for="{{goods}}" wx:key="id" bindtap="goToDetail" data-id="{{item.goodId}}">
        <image class="goods-image" src="{{item.images[0]}}" mode="aspectFill"></image>
        <view class="goods-info">
          <view class="goods-name">{{item.goodName}}</view>
          <view class="goods-price">¥{{item.price}}</view>
          <view class="goods-desc">{{item.description}}</view>
          <view class="goods-stats">
            <text class="views">{{item.view_msg}}次浏览</text>
            <text class="collect">{{item.collect}}人收藏</text>
          </view>
        </view>
      </view>
    </block>
  </view>
  
  <view class="load-more" wx:if="{{goods.length > 0 && !noMore}}" bindtap="loadMore">
    加载更多
  </view>
</view>