page {
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
}

.container {
  padding: 20rpx;
}

.tabs {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 0;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 25rpx rgba(102, 126, 234, 0.3);
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 25rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  position: relative;
  transition: all 0.3s ease;
}

.tab.active {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  font-weight: bold;
}

.tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #ffffff;
  border-radius: 3rpx;
}

.goods-list {
  margin-top: 20rpx;
}

.goods-item {
  display: flex;
  padding: 25rpx;
  margin-bottom: 25rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.goods-item::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.goods-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
}

.goods-image {
  width: 220rpx;
  height: 220rpx;
  border-radius: 16rpx;
  object-fit: cover;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.goods-info {
  flex: 1;
  margin-left: 25rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #2c3e50;
  line-height: 1.4;
}

.goods-price {
  font-size: 36rpx;
  color: #e74c3c;
  margin-bottom: 12rpx;
  font-weight: bold;
  text-shadow: 0 1rpx 2rpx rgba(231, 76, 60, 0.2);
}

.goods-price::before {
  content: "¥";
  font-size: 28rpx;
  margin-right: 2rpx;
}

.goods-desc {
  font-size: 26rpx;
  color: #7f8c8d;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  flex: 1;
  line-height: 1.5;
  margin-bottom: 15rpx;
}

.goods-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

.views,
.collect {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #6c757d;
  font-weight: 500;
}

.views::before {
  content: "👁";
  margin-right: 6rpx;
  font-size: 20rpx;
}

.collect::before {
  content: "❤️";
  margin-right: 6rpx;
  font-size: 20rpx;
}

.loading,
.empty {
  padding: 60rpx 30rpx;
  text-align: center;
  color: #95a5a6;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  margin: 40rpx 0;
}

.empty::before {
  content: "📦";
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.load-more {
  text-align: center;
  padding: 25rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  margin: 30rpx 0;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
}

.load-more:active {
  transform: translateY(2rpx);
  box-shadow: 0 3rpx 10rpx rgba(102, 126, 234, 0.4);
}
