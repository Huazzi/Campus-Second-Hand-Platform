/* pages/me/me.wxss */
.page-container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 头部样式 */
.header {
  background: linear-gradient(135deg, #7EC0EE, #5AA9E6);
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: white;
  padding: 60rpx 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(122, 192, 238, 0.2);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.user-details {
  margin-left: 30rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.credit-score {
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.score {
  font-weight: bold;
  color: #FFD700;
  margin-left: 10rpx;
}

.edit-profile {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 40rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.arrow {
  margin-left: 8rpx;
  font-weight: bold;
}

/* 内容区域 */
.content-section {
  background-color: white;
  border-radius: 24rpx;
  margin: 30rpx;
  padding: 0 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: block;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:active {
  background-color: #f9f9f9;
}

.menu-item.last-item {
  border-bottom: none;
}

.menu-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.menu-icon-text {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.menu-count {
  color: #888;
  font-size: 30rpx;
}