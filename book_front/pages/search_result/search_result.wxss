page {
  background-color: #f4f4f4;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 搜索框 */
.search_box {
  background-color: #fff;
  padding: 20rpx;
  display: flex;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);
}

input {
  width: 700rpx;
  height: 70rpx;
  padding: 0 30rpx;
  border-radius: 35rpx;
  background-color: #f0f0f0;
  font-size: 28rpx;
  color: #333;
  border: none;
}

/* 顶部选项栏 */
.options {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  padding: 24rpx 0;
  color: #666;
  font-size: 28rpx;
  border-bottom: 2rpx solid #e5e5e5;
}

.options view {
  padding: 0 20rpx;
}

/* 分类列表 */
.catagory {
  background-color: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.catagory view {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background-color: #f6f6f6;
  color: #888;
}

.catagory .selected {
  background-color: #ffeded;
  color: #ff4d4f;
  font-weight: 500;
}

/* 商品列表 */
.good_box {
  width: 47%;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 15rpx 1.5%;
  display: inline-block;
  vertical-align: top;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
}

.good_box:hover {
  transform: scale(1.02);
}

.good_box image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
  border-bottom: 1rpx solid #f0f0f0;
}

.good_box .name {
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.price {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx 20rpx;
  font-size: 26rpx;
  align-items: center;
}

.price text:first-child {
  color: #ff4d4f;
  font-weight: 500;
}

.price .noemphasize {
  color: #aaa;
  font-size: 24rpx;
}

/* 提示信息 */
view[style*='text-align:center'] {
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0 !important;
}
