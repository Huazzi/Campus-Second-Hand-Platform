page {
  background-color: #f5f5f5; /* 设置背景色为浅灰色 */
  height: 100%;
  padding: 0;
  margin: 0;
}

/* 每个列表项 */
.list_item {
  margin: 20rpx 0;
  background-color: #ffffff;
  border-radius: 12rpx; /* 圆角 */
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* 阴影效果 */
  padding: 15rpx;
}

.list_item_up {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1px solid #f1f1f1;
}

.list_item_up image {
  width: 160rpx; /* 图片宽度 */
  height: 160rpx;
  border-radius: 8rpx; /* 圆角图片 */
  object-fit: cover;
  margin-right: 20rpx; /* 图片和文字之间留空 */
}

.detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.good_name {
  font-family: "微软雅黑", sans-serif;
  font-weight: bold;
  font-size: 30rpx;
  color: #333;
  line-height: 1.4;
}

.price {
  font-size: 28rpx;
  color: #e74c3c; /* 设置价格为红色 */
  font-weight: bold;
  margin-top: 8rpx;
}

.noemphasize {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
}

/* 分隔线 */
.divide_line {
  margin-top: 12rpx;
  margin-bottom: 12rpx;
  border-top: 1px solid #f1f1f1;
}

/* 按钮区域 */
.btn_box {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

button {
  border-radius: 20rpx; /* 按钮圆角 */
  background-color: #f1f1f1;
  border: 1px solid #eeeeee;
  padding: 10rpx 25rpx;
  font-size: 26rpx;
  color: #333;
  text-align: center;
  transition: background-color 0.3s, transform 0.2s;
  margin: 0 10rpx;
}

button:hover {
  background-color: #e2e2e2;
}

button:active {
  background-color: #cccccc;
  transform: scale(0.98);
}

/* “已失效”按钮 */
.alarm {
  color: red;
  font-size: 28rpx;
  border: 1px solid red;
  background: none;
  padding: 10rpx 20rpx;
  border-radius: 25rpx;
  font-weight: bold;
}

/* 空状态页面 */
.empty {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100%;
  background-color: #ffffff;
}

.empty image {
  width: 50%;
  height: auto;
  margin-bottom: 20rpx;
}

.empty_text {
  text-align: center;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}
