page {
  background-color: #f5f5f5; /* 设置背景色为浅灰色 */
  height: 100%;
  padding: 0;
  margin: 0;
}

/* 每个列表项 */
.list_item {
  margin: 20rpx 0;
  background-color: #ffffff;
  border-radius: 12rpx; /* 添加圆角，提升现代感 */
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* 添加阴影 */
}

.list_item_up {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1px solid #f1f1f1; /* 在图片和详情之间加上分隔线 */
}

.list_item_up image {
  width: 160rpx; /* 缩小图片尺寸 */
  height: 160rpx;
  border-radius: 8rpx; /* 圆角图片 */
  object-fit: cover; /* 确保图片自适应 */
  margin-right: 20rpx; /* 图片和文字之间留空 */
}

.detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.good_name {
  font-family: "微软雅黑", sans-serif;
  font-weight: bold;
  font-size: 32rpx;
  color: #333; /* 商品名称的颜色 */
  line-height: 1.4;
}

.price {
  font-size: 30rpx;
  color: #e74c3c; /* 设置价格为红色 */
  font-weight: bold;
  margin-top: 10rpx;
}

.leave_msg {
  font-size: 26rpx;
  color: #888; /* 设置留言和收藏文字为灰色 */
  margin-top: 10rpx;
}

/* 分隔线 */
.divide_line {
  margin-top: 14rpx;
  margin-bottom: 14rpx;
  border-top: 1px solid #f1f1f1;
}

/* 按钮区域 */
.btn_box {
  display: flex;
  justify-content: flex-end;
  padding: 10rpx 20rpx;
}

button {
  border: 1px solid #eeeeee;
  border-radius: 20rpx; /* 添加圆角按钮 */
  background-color: #f1f1f1;
  padding: 10rpx 25rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
  transition: background-color 0.3s, transform 0.2s;
}

button:hover {
  background-color: #dddddd; /* 悬停时按钮变色 */
}

button:active {
  background-color: #cccccc; /* 点击时按钮变色 */
  transform: scale(0.95); /* 按钮点击时缩放 */
}

/* 空状态页面 */
.empty {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100%;
  background-color: #ffffff;
}

.empty image {
  width: 60%; /* 图片宽度改为60% */
  height: auto;
  margin-bottom: 20rpx;
}

.empty_text {
  text-align: center;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}
