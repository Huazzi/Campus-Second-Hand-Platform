/* pages/index/index.wxss */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica,
    Arial, sans-serif;
}

.container {
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;
}

/* 搜索容器 */
.search-container {
  background: linear-gradient(135deg, #7ec0ee 0%, #5baae0 100%);
  padding: 20rpx;
  border-bottom-left-radius: 16rpx;
  border-bottom-right-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/*首页功能菜单*/
.menu {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 10rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
}

.function {
  display: flex;
  width: 170rpx;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0;
  transition: transform 0.2s ease;
}

.function:active,
.function-hover {
  transform: scale(0.95);
}

.function image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  padding: 10rpx;
  background: linear-gradient(135deg, #e6f2ff 0%, #d1e9ff 100%);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}

.function text {
  font-size: 26rpx;
  margin-top: 10rpx;
  color: #333333;
}

/*搜索框*/
#search_box {
  background-color: #ffffff;
  border-radius: 40rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 6rpx 20rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

#search_box image {
  width: 40rpx;
  height: 40rpx;
}

#search_box input {
  height: 70rpx;
  width: 100%;
  margin-left: 10rpx;
  font-size: 28rpx;
}

/* 轮播图样式 */
.swiper-container {
  margin: 20rpx;
}

swiper {
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  height: 320rpx;
}

/*主页商品展示区*/
.home_good {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.home_good #newest {
  border-bottom: solid 2rpx #7ec0ee;
  display: block;
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.good {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.head {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #f0f0f0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.good_title {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 80%;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.time-info {
  margin-top: 4rpx;
}

/* 商品卡片样式 */
.good-item {
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 20rpx;
  display: block;
}

.good-item:last-child {
  margin-bottom: 0;
  border-bottom: none;
}

.good-description {
  margin: 16rpx 0;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
}

.good-image {
  margin: 16rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.good-image image {
  width: 100%;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.good-stats {
  display: flex;
  flex-direction: row;
  margin-top: 16rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  margin-right: 30rpx;
}

.stat-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

/* 价格标签样式 */
.price-tag {
  color: #ff4d4f;
  font-weight: bold;
  font-size: 36rpx;
}

/* 底部加载提示样式 */
.loading-tip {
  text-align: center;
  padding: 20rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 分割线美化 */
.divide_line {
  border: solid 1rpx #f0f0f0;
}

/* 悬浮按钮 */
.float-button {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #7ec0ee 0%, #5baae0 100%);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
  z-index: 999;
  transition: all 0.3s ease;
}

.float-button:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
}

.float-icon {
  width: 50rpx;
  height: 50rpx;
}
