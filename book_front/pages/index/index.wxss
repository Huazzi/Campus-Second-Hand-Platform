page {
  background-color: #f5f5f5;
  font-family: 'Helvetica Neue', sans-serif;
}

/* 搜索框 */
#search_box {
  background-color: #ffffff;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
#search_box image {
  width: 40rpx;
  height: 40rpx;
}
#search_box input {
  flex: 1;
  height: 80rpx;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #333;
}

/* 功能菜单 */
.menu {
  background-color: #ffffff;
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  margin: 20rpx;
}
.function {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}
.function image {
  width: 90rpx;
  height: 90rpx;
  margin-bottom: 10rpx;
}
.function text {
  font-size: 28rpx;
  color: #333;
}

/* 商品展示区 */
.home_good {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 20rpx;
  padding: 30rpx 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}
#newest {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  border-bottom: 4rpx solid #ff6347;
  padding-bottom: 10rpx;
  margin-bottom: 20rpx;
}
.good {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.good .head {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.good_title {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.good_title text:first-child {
  font-size: 32rpx;
  font-weight: bold;
}
.good_title .noemphasize {
  font-size: 24rpx;
  color: #999;
}
.noemphasize {
  font-size: 24rpx;
  color: #aaa;
}
.home_good image {
  border-radius: 16rpx;
  margin-top: 16rpx;
}

/* 底部提示 */
view[style*='text-align:center'] {
  font-size: 26rpx;
  color: #999;
}

/* 分隔线 */
.divide_line {
  height: 1rpx;
  background-color: #ddd;
  margin: 20rpx 0;
}
