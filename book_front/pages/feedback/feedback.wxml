<view class="feedback-container">
  <form bindsubmit='feedback'>
    <view class='feedback-card'>
      <view class='input-group'>
        <textarea 
          name="content" 
          placeholder='在此输入您使用小程序时遇到的问题，或您对我们的建议'
          class="feedback-textarea"
          auto-height
          maxlength="500"
          placeholder-class="placeholder-style"
        ></textarea>
        <view class='divide-line'></view>
        <input 
          name="contact" 
          placeholder='请输入您的联系方式（可选）'
          class="contact-input"
          placeholder-class="placeholder-style"
        ></input>
      </view>
    </view>
    <button form-type='submit' class="submit-btn">提交反馈</button>
  </form>
</view>