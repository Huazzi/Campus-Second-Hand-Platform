page {
  background-color: #f7f7f7;
  padding-bottom: 120rpx;
}

/* 头部信息 */
.title {
  background-color: white;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  border-radius: 12rpx 12rpx 0 0;
}

.title view {
  display: flex;
  flex-direction: column;
  padding-left: 20rpx;
}

.head {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  border: 2rpx solid #f0f0f0;
}

.noemphasize {
  color: #999;
  font-size: 26rpx;
  margin-top: 6rpx;
}

/* 分割线 */
.divide_line {
  height: 2rpx;
  background-color: #f0f0f0;
  width: 100%;
}

/* 价格区域 */
.price {
  font-weight: bold;
  color: #ff2d4a;
  padding: 24rpx;
  background: white;
  font-size: 52rpx;
  display: flex;
  align-items: center;
}

.preprice {
  color: #999;
  font-size: 34rpx;
  text-decoration: line-through;
  margin-left: 12rpx;
}

/* 描述 */
.description {
  padding: 0 24rpx 24rpx;
  background: white;
  font-size: 36rpx;
  line-height: 1.6;
  color: #333;
}

/* 图片 */
.imgs {
  padding: 0 24rpx 24rpx;
  background: white;
}

.imgs image {
  width: 50%;
  aspect-ratio: 4 / 3;
  margin-top: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  object-fit: cover;
}

/* 商品底部信息 */
.good_bottom {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  font-size: 28rpx;
  background: white;
  border-radius: 0 0 12rpx 12rpx;
}

.good_bottom .method {
  color: #1E90FF;
  font-weight: bold;
}

/* 用户信息 */
.ownerInfo {
  margin-top: 24rpx;
  padding: 24rpx;
  font-size: 28rpx;
  background: white;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-radius: 12rpx;
}

.ownerInfo text {
  display: block;
  margin-bottom: 12rpx;
}

/* 留言标题 */
.msgTitle {
  margin-top: 24rpx;
  padding: 24rpx;
  background: white;
  border-radius: 12rpx 12rpx 0 0;
}

/* 空留言提示 */
.msgBoard {
  padding: 60rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: white;
  border-radius: 0 0 12rpx 12rpx;
  font-size: 32rpx;
  color: #bbb;
  text-align: center;
}

.leave_msg {
  background: linear-gradient(to right, #FFD700, #FFA500);
  font-size: 30rpx;
  color: #333;
  padding: 14rpx 40rpx;
  border-radius: 40rpx;
  margin-top: 24rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 10rpx rgba(255, 165, 0, 0.2);
}

/* 页面底部提示 */
.bottom {
  margin: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #ccc;
}

/* 留言区域 */
.opposite, .self {
  display: flex;
  padding: 30rpx 24rpx;
  background-color: white;
  border-bottom: 1rpx solid #f0f0f0;
}

.opposite .head {
  border: 1rpx solid #e0e0e0;
  margin-right: 20rpx;
}

.limit {
  flex: 1;
}

.right {
  display: flex;
  flex-direction: column;
  background: #f8f8f8;
  padding: 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #444;
  margin-bottom: 8rpx;
}

.content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-word;
}

/* 固定底部操作栏 */
.fix_bottom {
  position: fixed;
  bottom: 0;
  width: 100%;
  padding: 20rpx 32rpx;
  background: white;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.1);
  z-index: 100;
}

.fix_bottom image {
  width: 50rpx;
  height: 50rpx;
}

.fix_bottom input {
  font-size: 30rpx;
  width: 70%;
  background: #f0f0f0;
  border-radius: 40rpx;
  padding: 20rpx;
  border: 1rpx solid #ddd;
}

.send {
  background: linear-gradient(to right, #FFD700, #FFA500);
  color: #333;
  border: none;
  font-size: 28rpx;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  font-weight: bold;
  margin-left: 20rpx;
}

/* 商品操作栏 */
.good_opt {
  font-size: 28rpx;
  color: #666;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.good_opt image {
  margin-right: 8rpx;
}

.leave_message, .collect {
  margin-right: 30rpx;
}

/* 按钮样式 */
.want {
  background: linear-gradient(to right, #ff2d4a, #ff6b81);
  padding: 12rpx 32rpx;
  color: white;
  border-radius: 50rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(255, 45, 74, 0.3);
  margin-left: 20rpx;
}

.want:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* 点击缩放动画 */
image:active {
  opacity: 0.6;
  transform: scale(0.95);
  transition: all 0.2s;
}
