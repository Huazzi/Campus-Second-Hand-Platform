/* 基础样式 */
page {
  background-color: #f5f5f5;
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  padding-bottom: 120rpx;
}

.container {
  padding: 20rpx;
}

/* 卡片样式 */
.form-card {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  margin-bottom: 20rpx;
}

/* 分段标题 */
.section {
  padding: 0 30rpx 30rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.section-title {
  display: block;
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 600;
  padding: 5rpx 0 5rpx;
  border-left: 8rpx solid #ff4d4f;
  padding-left: 20rpx;
  background-color: #fefefe;
  border-radius: 8rpx;
}

/* 输入框组 */
.input-group {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.input-field {
  height: 100rpx;
  font-size: 28rpx;
  color: #333;
}

.textarea-field {
  width: 100%;
  height: 180rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #333;
}

.char-counter {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  padding-bottom: 10rpx;
}

/* 图片上传 */
.image-uploader {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0;
}

.image-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.remove-icon {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #999;
  font-size: 24rpx;
}

.plus-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
}

/* 表单项目 */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
}

.item-label {
  font-size: 28rpx;
  color: #333;
}

.picker {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.arrow-icon {
  width: 30rpx;
  height: 30rpx;
  margin-left: 10rpx;
}

/* 价格输入 */
.price-input {
  display: flex;
  align-items: center;
}

.currency-symbol {
  font-size: 28rpx;
  color: #ff4d4f;
  margin-right: 10rpx;
}

.input-price {
  text-align: right;
  font-size: 28rpx;
  color: #ff4d4f;
  width: 200rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #f0f0f0;
}

.divider-light {
  height: 1rpx;
  background-color: #f5f5f5;
}

/* 提交按钮 */
.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  background: linear-gradient(90deg, #ff4d4f, #ff7875);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  height: 90rpx;
  line-height: 90rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 77, 79, 0.3);
}

.input-group,
.form-item,
.price-input {
  margin-top: 20rpx;
}