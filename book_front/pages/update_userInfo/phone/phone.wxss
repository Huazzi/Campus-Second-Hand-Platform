/* pages/update_userInfo/phone/phone.wxss */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
}

.container {
  padding: 30rpx;
}

.form-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  border: 1rpx solid #eaeaea;
  box-sizing: border-box;
}

.placeholder {
  color: #b2b2b2;
  font-size: 28rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(90deg, #1E90FF, #00BFFF);
  color: white;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-top: 20rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(30, 144, 255, 0.3);
}

.submit-btn-hover {
  opacity: 0.9;
  transform: translateY(2rpx);
}