/* 基础样式 */
page {
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  padding-bottom: 120rpx;
  min-height: 100vh;
}

.container {
  padding: 20rpx;
  animation: fadeIn 0.6s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 卡片样式 */
.form-card {
  background: linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08), 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10rpx);
}

/* 分段标题 */
.section {
  padding: 30rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 16rpx;
  margin-top: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  position: relative;
  overflow: hidden;
}

.section::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #ff4d4f, #ff7875, #ffa39e);
}

.section-title {
  display: block;
  font-size: 34rpx;
  color: #1a1a1a;
  font-weight: 700;
  padding: 20rpx 0 30rpx;
  position: relative;
  letter-spacing: 1rpx;
}

.section-title::after {
  content: "";
  position: absolute;
  bottom: 10rpx;
  left: 0;
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #ff4d4f, #ff7875);
  border-radius: 2rpx;
}

/* 输入框组 */
.input-group {
  background: linear-gradient(145deg, #f8f9fa 0%, #ffffff 100%);
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.input-group:focus-within {
  border-color: #ff4d4f;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.06),
    0 0 0 4rpx rgba(255, 77, 79, 0.1);
}

.input-field {
  height: 100rpx;
  font-size: 28rpx;
  color: #333;
  background: transparent;
  transition: all 0.3s ease;
}

.input-field:focus {
  color: #1a1a1a;
}

.optional-field {
  color: #666;
  background: linear-gradient(145deg, #f0f1f2 0%, #f8f9fa 100%);
  border-radius: 12rpx;
  padding: 0 16rpx;
}

.optional-hint {
  font-size: 22rpx;
  color: #999;
  padding: 12rpx 0;
  line-height: 1.5;
  display: flex;
  align-items: center;
}

.optional-hint::before {
  content: "💡";
  margin-right: 8rpx;
  font-size: 20rpx;
}

.textarea-field {
  width: 100%;
  height: 180rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #333;
}

.char-counter {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  padding-bottom: 10rpx;
}

/* 图片上传 */
.image-uploader {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0;
  gap: 20rpx;
}

.image-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.remove-icon {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  padding: 6rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #e0e0e0;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #999;
  font-size: 24rpx;
  background-color: #fafafa;
  transition: all 0.3s ease;
}

.upload-btn:active {
  background-color: #f0f0f0;
  border-color: #ff4d4f;
}

.plus-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
  opacity: 0.6;
}

/* 表单项目 */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  min-height: 80rpx;
}

.item-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex-shrink: 0;
  width: 160rpx;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 20rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
  min-height: 60rpx;
}

.picker:active {
  background-color: #f0f0f0;
}

.arrow-icon {
  font-size: 32rpx;
  color: #ccc;
  transform: rotate(90deg);
}

/* 价格输入 */
.price-input {
  display: flex;
  align-items: center;
}

.currency-symbol {
  font-size: 28rpx;
  color: #ff4d4f;
  margin-right: 10rpx;
}

.input-price {
  text-align: right;
  font-size: 28rpx;
  color: #ff4d4f;
  width: 200rpx;
}

.input-field-inline {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: #333;
  text-align: right;
  background: transparent;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background-color: #f8f9fa;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #f0f0f0;
}

.divider-light {
  height: 1rpx;
  background-color: #f5f5f5;
}

/* 提交按钮 */
.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.95) 20%,
    #ffffff 100%
  );
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);
  border-top: 1rpx solid rgba(255, 255, 255, 0.8);
}

.submit-btn {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 50%, #ffa39e 100%);
  color: #fff;
  border-radius: 60rpx;
  font-size: 34rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 77, 79, 0.4),
    0 4rpx 12rpx rgba(255, 77, 79, 0.2);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  letter-spacing: 2rpx;
}

.submit-btn::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.3),
    transparent
  );
  transition: left 0.6s ease;
}

.submit-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3),
    0 2rpx 6rpx rgba(255, 77, 79, 0.2);
}

.submit-btn:active::before {
  left: 100%;
}

.submit-btn.submitting {
  background: linear-gradient(135deg, #ccc 0%, #ddd 50%, #eee 100%);
  color: #999;
  box-shadow: none;
  transform: none;
}

.submit-btn.submitting::before {
  display: none;
}

.input-group,
.form-item,
.price-input {
  margin-top: 20rpx;
}
