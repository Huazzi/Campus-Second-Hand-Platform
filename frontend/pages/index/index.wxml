<!--pages/index/index.wxml-->
<view class="container">
  <!--搜索栏-->
  <view class="search-container">
    <form>
      <view id='search_box'>
        <image src='/image/search2.png'></image>
        <input placeholder='搜索' confirm-type='search' bindconfirm='search'></input>
      </view>
    </form>
  </view>

  <!--轮播图-->
  <view class="swiper-container">
    <swiper autoplay='{{true}}' indicator-dots='{{true}}' interval='3000' circular='{{true}}'>
      <swiper-item wx:for="{{homeImages}}">
        <image src='{{item}}' mode='aspectFill' style='width:100%;height:100%;'></image>
      </swiper-item>
    </swiper>
  </view>

  <!--功能选项-->
  <view class='menu'>
    <navigator url='/pages/ai_chat/ai_chat' class='function' hover-class='function-hover'>
        <image src='/image/ai_assistant.png'></image>
        <text>智能小二</text>
    </navigator>
    <navigator url='/pages/recommendations/recommendations' class='function' hover-class='function-hover'>
        <image src='/image/recommend01.png'></image>
        <text>智能推荐</text>
    </navigator>
    <navigator url='/pages/shopchart/shopchart' class='function' hover-class='function-hover'
    open-type="switchTab">
        <image src='/image/goods_cart.png'></image>
        <text>购物车</text>
    </navigator>
    <navigator url='/pages/search_result/search_result?key=&catagory=图书音像' class='function' hover-class='function-hover'>
      <image src='/image/book.png'></image>
      <text>二手书</text>
    </navigator>
    <!-- <navigator url='/pages/collected_goods/collected' class='function' hover-class='none'>
      <image src='/image/zulin.png'></image>
      <text>我的收藏</text>
    </navigator> -->
    <!-- <navigator url='/pages/search_result/search_result?key=' class='function' hover-class='none'>
      <image src='/image/search.png'></image>
      <text>分类搜索</text>
    </navigator> -->
  </view>
  
  <!-- 商品 -->
  <view class='home_good'>
    <text id='newest'>最新上架</text>
    <navigator wx:for='{{goods}}' url='/pages/good/good?goodId={{item.goodId}}' class="good-item">
      <view class='good'>
        <image src='{{item.goodOwner.head}}' class='head'></image>
        <view class='good_title'>
          <view class="user-info">
            <text class="user-name">{{item.goodOwner.nickname}}</text>
            <text class='noemphasize time-info'>{{item.time}}</text>
          </view>
          <text class='price-tag'>￥{{item.price}}</text>
        </view>
      </view>

      <view class="good-description">{{item.description}}</view>

      <view class="good-image">
        <image mode="widthFix" src='{{appInstance.globalData.host + "img/goods/" + item.images}}'></image>
      </view>
      <view class="good-stats">
        <view class="stat-item">
          <text class='stat-text'>{{item.viewCount || 0}}次浏览</text>
        </view>
        <view class="stat-item">
          <image src="/image/message.png" class="stat-icon"></image>
          <text class='noemphasize'>{{item.leave_msg}}</text>
        </view>
        <view class="stat-item">
          <image src="/image/star.png" class="stat-icon"></image>
          <text class='noemphasize'>{{item.collect}}</text>
        </view>
      </view>
    </navigator>
  </view>
  <view class='loading-tip'>{{tip}}</view>

  <!-- 悬浮发布按钮 -->
  <!-- <view class="float-button" bindtap="release">
    <image src="/image/add_good.png" class="float-icon"></image>
  </view> -->
</view>