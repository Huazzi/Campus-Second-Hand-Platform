/* 页面背景 */
page {
  background-color: #f2f2f2;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial;
}

/* 消息项整体样式 */
.list_item {
  background-color: #fff;
  margin: 12rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: row;
  padding: 20rpx;
  align-items: center;
  transition: all 0.3s ease;
  border: 1rpx solid #f0f0f0;
}

.list_item:active {
  background-color: #f8f9fa;
  transform: scale(0.98);
}

/* 对话信息区域 */
.conversation-info {
  flex: 1;
  display: flex;
  align-items: center;
}

/* 头像样式 */
.head {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 2rpx solid #e8e8e8;
}

/* 消息详情部分 */
.detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 对话头部信息 */
.conversation-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.time {
  font-size: 24rpx;
  color: #999;
}

/* 最后一条消息 */
.last-message {
  display: flex;
  align-items: center;
}

.message-prefix {
  font-size: 26rpx;
  color: #666;
  margin-right: 4rpx;
}

.message-content {
  font-size: 26rpx;
  color: #888;
  max-width: 300rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 商品信息区域 */
.good-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 16rpx;
}

/* 商品图片样式 */
.goodImg {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  object-fit: cover;
  border: 1rpx solid #e8e8e8;
}

.good-name {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
  max-width: 100rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* AI 客服样式优化 */
.ai-assistant {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  background: linear-gradient(90deg, #fefefe, #f8f8ff);
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.ai-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 2rpx solid #ddd;
}

.msg-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.msg-title {
  font-size: 34rpx;
  color: #333;
  font-weight: bold;
}

.msg-desc {
  font-size: 28rpx;
  color: #999;
  margin-top: 6rpx;
}

.msg-time {
  font-size: 24rpx;
  color: #bbb;
  margin-left: 20rpx;
}
