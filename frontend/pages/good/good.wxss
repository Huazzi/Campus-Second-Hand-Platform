/* pages/good/good.wxss */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica,
    Arial, sans-serif;
}

.container {
  padding-bottom: 120rpx;
}

/* 顶部用户信息 */
.title {
  background-color: white;
  padding: 24rpx 30rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  border-bottom-left-radius: 20rpx;
  border-bottom-right-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.head {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid #f0f0f0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.user-info {
  display: flex;
  flex-direction: column;
  padding: 16rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.publish-time {
  font-size: 26rpx;
  color: #888;
}

/* 分割线 */
.divide_line {
  border: solid 1rpx #f0f0f0;
  margin: 6rpx 0;
}

/* 价格区域 */
.price-container {
  background: white;
  margin-top: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.price {
  font-weight: bold;
  color: #ff4d4f;
  padding: 24rpx 30rpx;
  font-size: 48rpx;
  display: flex;
  align-items: baseline;
}

.preprice {
  color: #8a8a8a;
  text-decoration: line-through;
  font-size: 28rpx;
  margin-left: 16rpx;
}

/* 描述区域 */
.description {
  padding: 10rpx 30rpx 30rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: #333;
}

/* 图片区域 */
.imgs {
  padding: 0 30rpx;
}

.good-image {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 商品统计信息 */
.stats-container {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
  padding: 16rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #f0f0f0;
}

.stat-item {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 8rpx;
}

.stat-value {
  font-size: 26rpx;
  color: #333;
}

.stat-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

/* 商品图片底部 */
.good_bottom {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}

.trade-info {
  display: flex;
  align-items: center;
}

.method {
  color: #1890ff;
  background: rgba(24, 144, 255, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.collect-info {
  display: flex;
  align-items: center;
}

.collect-icon {
  width: 36px;
  height: 32px;
  margin-right: 8rpx;
}

/* 用户信息 */
.ownerInfo {
  margin: 20rpx;
  padding: 30rpx;
  font-size: 28rpx;
  background: white;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.owner-details {
  flex: 1;
  padding-right: 20rpx;
}

.owner-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.owner-intro {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}

.owner-bio {
  font-size: 28rpx;
  color: #888;
  display: block;
}

.owner-avatar-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.verify-badge {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  background: rgba(24, 144, 255, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 30rpx;
}

.verify-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
}

.verify-text {
  color: #1890ff;
  font-size: 24rpx;
}

/* 留言区域 */
.message-container {
  margin: 20rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.msgTitle {
  padding: 24rpx 30rpx;
  border-bottom: 1px solid #f0f0f0;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.msgBoard {
  padding: 36rpx 0;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: center;
}

.empty-message {
  color: #cdcdcd;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.leave_msg {
  background: linear-gradient(135deg, #ffe54c 0%, #ffcb05 100%);
  font-size: 30rpx;
  color: #333;
  border: none;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.leave_msg:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 留言列表 */
.message-list {
  padding: 10rpx 0;
}

.message-item {
  display: flex;
  padding: 20rpx 30rpx;
  border-bottom: solid 1rpx #f0f0f0;
}

.message-item:last-child {
  border-bottom: none;
}

.message-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.message-content {
  display: flex;
  flex-direction: column;
}

.limit {
  max-width: calc(100% - 86rpx);
}

.nickname {
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.content {
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
  max-width: 100%;
  word-break: break-all;
}

.bottom {
  margin: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

/* 固定底部 */
.fix_bottom {
  position: fixed;
  bottom: 0;
  width: 100%;
  padding: 20rpx 30rpx;
  background: white;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  z-index: 10;
}

.fix_bottom image {
  width: 44rpx;
  height: 44rpx;
}

.close-icon {
  margin-right: 16rpx;
}

.fix_bottom input {
  background: #f5f5f5;
  height: 70rpx;
  font-size: 28rpx;
  width: 60%;
  border-radius: 35rpx;
  padding: 0 20rpx;
}

.action-buttons {
  display: flex;
}

.want {
  background: linear-gradient(135deg, #ff7875 0%, #ff4d4f 100%);
  padding: 14rpx 30rpx;
  color: white;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  margin-left: 16rpx;
}

.buy-button {
  background: linear-gradient(135deg, #ffa940 0%, #fa8c16 100%);
}

.want:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.send {
  background: linear-gradient(135deg, #ffe54c 0%, #ffcb05 100%);
  color: #333;
  border: none;
  font-size: 28rpx;
  padding: 0;
  border-radius: 30rpx;
  min-width: 120rpx;
  height: 70rpx;
  line-height: 70rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  margin-left: 16rpx;
}

.send:active {
  transform: scale(0.95);
}

.send::after {
  border: none;
}

/* 底部操作栏 */
.good_opt {
  font-size: 28rpx;
  color: #666;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.action-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 8rpx;
}

.leave_message,
.collect {
  display: inline-flex;
  align-items: center;
  margin-right: 24rpx;
  padding: 8rpx 16rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 30rpx;
}

.noemphasize {
  font-size: 28rpx;
  color: #8a8a8a;
}

/* 适配iPhoneX等全面屏 */
@media screen and (min-height: 800px) {
  .fix_bottom {
    padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  }
}
