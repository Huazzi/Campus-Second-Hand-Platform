<!--pages/good/good.wxml-->
<view class="container">
  <!-- 头像、昵称、时间 -->
  <view class='title'>
    <image src='{{good.goodOwner.head}}' class='head'></image>
    <view class="user-info">
      <text class="user-name">{{good.goodOwner.nickname}}</text>
      <text class='noemphasize publish-time'>{{good.time}}</text>
    </view>
  </view>

  <!-- 价格区域 -->
  <view class='price-container'>
    <view class='price'>
      <text>￥{{good.price}}</text>
      <text class='preprice'>￥288</text>
    </view>

    <!-- 描述 -->
    <view class='description'>
      <text>{{good.description}}</text>
    </view>

    <!-- 图片 -->
    <view class='imgs'>
      <image wx:for='{{goodImgs}}' wx:key="index" data-imgUrl='{{item}}' bindtap='viewImage' mode='widthFix' src='{{item}}' class="good-image"></image>
    </view>

    <!-- 商品统计信息 -->
    <view class='stats-container'>
      <view class="stat-item">
        <text class='stat-label'>浏览:</text>
        <text class='stat-value'>{{good.viewCount || 0}}次</text>
      </view>
      <view class="stat-item">
        <image src="/image/star.png" class="stat-icon"></image>
        <text class='stat-value'>{{good.collect || 0}}人收藏</text>
      </view>
    </view>

    <!-- 交易方式、收藏 -->
    <view class='good_bottom'>
      <view class="trade-info">
        <text class='method'>见面交易</text>
      </view>
      <view class="collect-info">
        <image bindtap='unCollect' wx:if='{{isCollect}}' src='/image/star-fill.png' class="collect-icon"></image>
        <image bindtap='collect' wx:else src='/image/star.png' class="collect-icon"></image>
        <text class='noemphasize'>收藏</text>
      </view>
    </view>
  </view>

  <!-- 用户信息 -->
  <view class='ownerInfo'>
    <view class="owner-details">
      <text class="owner-name">{{good.goodOwner.nickname}}</text>
      <text class="owner-intro">{{"来自" + good.goodOwner.college + "，卖出过0件宝贝"}}</text>
      <text class="owner-bio">{{"这家伙很懒，什么都没有留下"}}</text>
    </view>
    <view class="owner-avatar-container">
      <image src='{{good.goodOwner.head}}' class='head'></image>
      <view class="verify-badge">
        <image class="verify-icon" src='/image/vertify.png'></image>
        <text class="verify-text">学生认证</text>
      </view>
    </view>
  </view>

  <!-- 留言板块 -->
  <view class="message-container">
    <view class='msgTitle'>
      <text class="section-title">留言</text>
    </view>

    <view wx:if="{{msgList.length == 0}}" class='msgBoard'>
      <text class='empty-message'>还没有人留言，还不快来抢沙发</text>
      <view class="leave_msg" bindtap='leave_msg'>留言</view>
    </view>
    <view wx:else class="message-list">
      <block wx:for='{{msgList}}' wx:key="index">
        <view class='message-item'>
          <image class='message-avatar' src='{{item.send.head}}'></image>
          <view class='limit'>
            <view class="message-content">
              <view class='nickname'>{{item.send.nickname}}</view>
              <view class='content'>{{item.content}}</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>
  
  <!-- 页面底部 -->
  <view class='bottom'>
    底部了哟~
  </view>

  <!-- 固定底部功能 -->
  <form bindsubmit='send'>
    <view wx:if='{{leave_msg}}' class='fix_bottom'>
      <image src='/image/down.png' class="close-icon" bindtap='cancel_msg'></image>
      <input name="content" type='text' value='{{tempMsg}}' placeholder='看对眼就留言，问问更多细节~'></input>
      <button form-type='submit' class='send'>发送</button>
    </view>
  </form>

  <view wx:if='{{!leave_msg}}' class='fix_bottom'>
    <view class='good_opt'>
      <text class='leave_message' bindtap='leave_msg'>
        <image src='/image/leave_msg.png' class="action-icon"></image>留言
      </text>
      <text bindtap='collect' class='collect'>
        <image src='/image/collect.png' class="action-icon"></image>收藏
      </text>
    </view>
    <view class="action-buttons">
      <view class='want buy-button' bindtap='buy'>购买</view>
      <view class='want chat-button' bindtap='chat'>我想要</view>
    </view>
  </view>
</view>